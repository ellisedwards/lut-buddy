# Read-only extraction of an additional RTMD field documented by telemetry-parser.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Sony::rtmd' => {
        0x810e => { Name => 'CameraWBKelvin', Format => 'int16u' },
    },
);
# Additional documented Sony RTMD lens text, read without modifying the clip.
$Image::ExifTool::UserDefined{'Image::ExifTool::Sony::rtmd'}{0x8007} = { Name => 'RecordedLensAttributes', Format => 'string' };

1;
